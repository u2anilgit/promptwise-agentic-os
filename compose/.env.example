# Host interface to bind published ports to: 127.0.0.1 = local-only, 0.0.0.0 = LAN-exposed (opt-in)
BIND_ADDR=127.0.0.1

GATEWAY_PORT=8420
OLLAMA_PORT=11434
QDRANT_PORT=6333

OLLAMA_IMAGE_TAG=0.3.12
QDRANT_IMAGE_TAG=v1.11.0

# Host directory bind-mounted into the gateway container at /app/.promptwise
# (config layers 2-4: org/project/local overrides — see docs/ARCHITECTURE.md §4)
CONFIG_DIR=./config
